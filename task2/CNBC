from playwright.sync_api import sync_playwright
import csv
import time

# ==========================================
# SETTINGS
# ==========================================

MAX_ARTICLES = 200

sections = [
    "https://www.cnbc.com/world/",
    "https://www.cnbc.com/business/",
    "https://www.cnbc.com/technology/",
    "https://www.cnbc.com/finance/",
    "https://www.cnbc.com/markets/"
]


# ==========================================
# START PLAYWRIGHT
# ==========================================

with sync_playwright() as p:

    browser = p.chromium.launch(
        headless=True
    )

    page = browser.new_page(
        user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/150.0.0.0 Safari/537.36"
    )

    article_urls = set()


    # ==========================================
    # COLLECT ARTICLE URLs
    # ==========================================

    for section in sections:

        print("\nOpening section:", section)

        try:

            page.goto(
                section,
                wait_until="domcontentloaded",
                timeout=60000
            )

            # Wait for JavaScript content
            page.wait_for_timeout(4000)


            # Scroll page multiple times
            for i in range(5):

                page.mouse.wheel(
                    0,
                    3000
                )

                page.wait_for_timeout(2000)


            # Get all links from page
            links = page.locator("a").evaluate_all(
                "elements => elements.map(e => e.href)"
            )


            # Filter article URLs
            for href in links:

                if not href:
                    continue


                # Remove query parameters
                href = href.split("?")[0]


                # Only CNBC URLs
                if not href.startswith(
                    "https://www.cnbc.com/"
                ):
                    continue


                # Skip unwanted pages
                if any(
                    x in href
                    for x in [
                        "/video/",
                        "/live/",
                        "/podcast/",
                        "/pro/",
                        "/watch/",
                        "/search/"
                    ]
                ):
                    continue


                # CNBC articles normally contain .html
                if ".html" in href:

                    article_urls.add(href)


            print(
                "URLs collected so far:",
                len(article_urls)
            )


        except Exception as e:

            print(
                "Section Error:",
                e
            )


    # ==========================================
    # LIMIT TO 200 ARTICLES
    # ==========================================

    article_urls = list(article_urls)

    print(
        "\nTotal URLs found:",
        len(article_urls)
    )


    article_urls = article_urls[
        :MAX_ARTICLES
    ]


    print(
        "Articles to scrape:",
        len(article_urls)
    )


    # ==========================================
    # CREATE CSV
    # ==========================================

    with open(
        "cnbc_news.csv",
        "w",
        newline="",
        encoding="utf-8-sig"
    ) as file:

        writer = csv.writer(file)


        # CSV headings
        writer.writerow([
            "source_url",
            "publish_date",
            "news_paper_name",
            "title",
            "first_paragraph"
        ])


        count = 0


        # ==========================================
        # SCRAPE ARTICLES
        # ==========================================

        for url in article_urls:

            try:

                print(
                    "\nOpening article:",
                    url
                )


                # Open article
                page.goto(
                    url,
                    wait_until="domcontentloaded",
                    timeout=60000
                )


                # Wait for JavaScript
                page.wait_for_timeout(3000)


                # ==================================
                # TITLE
                # ==================================

                title = "Not available"


                title_selectors = [
                    "h1",
                    "h1.ArticleHeader-headline",
                    "[data-testid='headline']",
                    ".ArticleHeader-headline"
                ]


                for selector in title_selectors:

                    try:

                        element = page.locator(
                            selector
                        ).first


                        if element.count() > 0:

                            text = element.inner_text()

                            text = text.strip()


                            if text:

                                title = text

                                break


                    except Exception:

                        continue


                # ==================================
                # PUBLISH DATE
                # ==================================

                publish_date = "Not available"


                date_selectors = [
                    "time",
                    "[data-testid='published-date']",
                    ".ArticleHeader-date",
                    ".ArticleHeader-time"
                ]


                for selector in date_selectors:

                    try:

                        element = page.locator(
                            selector
                        ).first


                        if element.count() > 0:

                            # First try visible text
                            text = element.inner_text()

                            text = text.strip()


                            if text:

                                publish_date = text

                                break


                            # Try datetime attribute
                            datetime_value = element.get_attribute(
                                "datetime"
                            )


                            if datetime_value:

                                publish_date = datetime_value

                                break


                    except Exception:

                        continue


                # ==================================
                # FIRST PARAGRAPH
                # ==================================

                first_paragraph = "Not available"


                paragraph_selectors = [

                    # CNBC article body
                    "div.ArticleBody-articleBody p",

                    # Alternative article body
                    ".ArticleBody-articleBody p",

                    # Data-testid article body
                    "[data-testid='article-body'] p",

                    # Generic article
                    "article p",

                    # Main content
                    "main p"
                ]


                for selector in paragraph_selectors:

                    try:

                        paragraphs = page.locator(
                            selector
                        )


                        total = paragraphs.count()


                        if total > 0:

                            # Check first 10 paragraphs
                            for i in range(
                                min(total, 10)
                            ):

                                text = paragraphs.nth(
                                    i
                                ).inner_text()


                                text = text.strip()


                                # Ignore empty or very short text
                                if len(text) < 20:

                                    continue


                                first_paragraph = text

                                break


                            # Stop if paragraph found
                            if first_paragraph != "Not available":

                                break


                    except Exception:

                        continue


                # ==================================
                # SAVE DATA TO CSV
                # ==================================

                writer.writerow([
                    url,
                    publish_date,
                    "CNBC",
                    title,
                    first_paragraph
                ])


                # Save immediately
                file.flush()


                count += 1


                # Print result
                print(
                    f"{count}. {title}"
                )


                print(
                    "Date:",
                    publish_date
                )


                print(
                    "First paragraph:",
                    first_paragraph
                )


                # Small delay
                time.sleep(1)


            except Exception as e:

                print(
                    "\nArticle Error:",
                    url
                )

                print(
                    "Error:",
                    e
                )

                # Continue with next article
                continue


    # ==========================================
    # CLOSE BROWSER
    # ==========================================

    browser.close()


# ==========================================
# FINAL RESULT
# ==========================================

print(
    "\n=============================="
)

print(
    "Scraping Completed!"
)

print(
    "Total Articles Saved:",
    count
)

print(
    "CSV File: cnbc_news.csv"
)

print(
    "=============================="
)