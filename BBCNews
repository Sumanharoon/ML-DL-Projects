import requests
from bs4 import BeautifulSoup
import csv
import time

headers = {
    "User-Agent": "Mozilla/5.0"
}

sections = [
    "https://www.bbc.com/news",
    "https://www.bbc.com/news/world",
    "https://www.bbc.com/news/world/us_and_canada",
    "https://www.bbc.com/news/business",
    "https://www.bbc.com/news/technology",
    "https://www.bbc.com/news/science_and_environment",
    "https://www.bbc.com/news/health"
]

article_urls = set()

# ---------------------------
# Collect Article URLs
# ---------------------------

for page in sections:

    print("Opening:", page)

    try:
        response = requests.get(
            page,
            headers=headers,
            timeout=20
        )

        soup = BeautifulSoup(response.text, "html.parser")

        links = soup.find_all("a", href=True)

        for link in links:

            href = link["href"]

            # Relative URL ko complete URL banana
            if href.startswith("/news/"):
                href = "https://www.bbc.com" + href

            # Sirf BBC news articles
            if href.startswith("https://www.bbc.com/news/"):

                # Extra query parameters remove karna
                href = href.split("?")[0]

                # Video aur live pages ko skip karna
                if "/videos/" not in href and "/live/" not in href:

                    article_urls.add(href)

    except Exception as e:
        print("Error:", e)


# Set ko list mein convert
article_urls = list(article_urls)

# Stable order
article_urls = sorted(article_urls)

print("Total URLs Found:", len(article_urls))

# Maximum 200 articles
article_urls = article_urls[:200]


# ---------------------------
# Scrape Articles
# ---------------------------

with open(
    "bbc_news.csv",
    "w",
    newline="",
    encoding="utf-8-sig"
) as file:

    writer = csv.writer(file)

    writer.writerow([
        "source_url",
        "publish_date",
        "news_paper_name",
        "title",
        "first_paragraph"
    ])

    count = 0

    for url in article_urls:

        try:

            print("\nOpening Article:", url)

            response = requests.get(
                url,
                headers=headers,
                timeout=20
            )

            soup = BeautifulSoup(
                response.text,
                "html.parser"
            )

            # ---------------------------
            # Title
            # ---------------------------

            title = soup.find("h1")

            if title:
                title = title.get_text(
                    " ",
                    strip=True
                )
            else:
                title = "Not available"


            # ---------------------------
            # Publish Date
            # ---------------------------

            date = soup.select_one(
                "time[datetime]"
            )

            if date:

                publish_date = (
                    date.get("datetime")
                    or date.get_text(
                        " ",
                        strip=True
                    )
                )

            else:

                publish_date = "Not available"


            # ---------------------------
            # First Paragraph
            # ---------------------------

            paragraph = soup.select_one(
                "main p"
            )

            if not paragraph:

                paragraph = soup.select_one(
                    "article p"
                )

            if paragraph:

                first_paragraph = (
                    paragraph.get_text(
                        " ",
                        strip=True
                    )
                )

            else:

                first_paragraph = "Not available"


            # ---------------------------
            # Save to CSV
            # ---------------------------

            writer.writerow([
                url,
                publish_date,
                "BBC News",
                title,
                first_paragraph
            ])

            count += 1

            print(
                f"{count}. {title}"
            )

            time.sleep(1)


        except Exception as e:

            print(
                "Error:",
                e
            )


print("\nScraping Completed!")

print(
    "Total Articles Saved:",
    count
)