import requests
from bs4 import BeautifulSoup
import csv
import time

# ==========================================
# 1. Guardian ke different sections
# ==========================================

sections = [
    "world",
    "uk-news",
    "business",
    "technology",
    "science",
    "sport"
]

# Yahan article URLs store honge
article_urls = []


# ==========================================
# 2. Har section se article URLs collect karo
# ==========================================

for section in sections:

    url = f"https://www.theguardian.com/{section}"

    print(f"\nOpening section: {section}")

    response = requests.get(url)

    soup = BeautifulSoup(
        response.text,
        "html.parser"
    )

    # Article links find karo
    links = soup.select("a.dcr-idxb0f")

    print("Links found:", len(links))


    # Har link ko check karo
    for link in links:

        href = link.get("href")

        if href:

            # Relative URL ko full URL banao
            if href.startswith("/"):
                href = "https://www.theguardian.com" + href

            # Sirf Guardian ke article URLs rakho
            if (
                href.startswith("https://www.theguardian.com/")
                and href not in article_urls
            ):
                article_urls.append(href)


    # Agar 200 URLs mil gaye to loop stop
    if len(article_urls) >= 200:
        break


# ==========================================
# 3. Sirf first 200 unique articles
# ==========================================

article_urls = article_urls[:200]

print("\nTotal unique articles:", len(article_urls))


# ==========================================
# 4. CSV file create karo
# ==========================================

with open(
    "guardian_news.csv",
    "w",
    newline="",
    encoding="utf-8"
) as file:

    writer = csv.writer(file)

    # CSV headings
    writer.writerow([
        "source_url",
        "publish_date",
        "news_paper_name",
        "title",
        "first_paragraph"
    ])


    # ==========================================
    # 5. Har article ko scrape karo
    # ==========================================

    for i, article_url in enumerate(
        article_urls,
        start=1
    ):

        print(
            f"Scraping article {i}/{len(article_urls)}"
        )

        try:

            # Article page open karo
            article_response = requests.get(
                article_url
            )

            # HTML parse karo
            article_soup = BeautifulSoup(
                article_response.text,
                "html.parser"
            )


            # ==========================================
            # Title
            # ==========================================

            title_element = article_soup.select_one(
                "h1.dcr-l0wuod"
            )

            if title_element:

                title = title_element.get_text(
                    " ",
                    strip=True
                )

            else:

                title = "Not available"


            # ==========================================
            # Publish Date
            # ==========================================

            date_element = article_soup.select_one(
                "span.dcr-10i63lj"
            )

            if date_element:

                publish_date = date_element.get_text(
                    " ",
                    strip=True
                )

            else:

                publish_date = "Not available"


            # ==========================================
            # First Paragraph
            # ==========================================

            paragraph_element = article_soup.select_one(
                "p.dcr-1s160rg"
            )

            if paragraph_element:

                first_paragraph = paragraph_element.get_text(
                    " ",
                    strip=True
                )

            else:

                first_paragraph = "Not available"


            # ==========================================
            # CSV mein data save karo
            # ==========================================

            writer.writerow([
                article_url,
                publish_date,
                "The Guardian",
                title,
                first_paragraph
            ])


            # Har request ke darmiyan 1 second wait
            time.sleep(1)


        except Exception as e:

            print(
                f"Error: {e}"
            )


# ==========================================
# 6. Final message
# ==========================================

print("\nScraping completed!")
print(
    f"Total articles scraped: {len(article_urls)}"
)