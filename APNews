import requests
from bs4 import BeautifulSoup
import csv
import time

headers = {
    "User-Agent": "Mozilla/5.0"
}

sections = [
    "https://apnews.com/world-news",
    "https://apnews.com/politics",
    "https://apnews.com/business",
    "https://apnews.com/science",
    "https://apnews.com/technology",
    "https://apnews.com/us-news"
]

article_urls = set()

# Collect article URLs
for page in sections:

    print("Opening:", page)

    try:
        response = requests.get(page, headers=headers, timeout=15)
        soup = BeautifulSoup(response.text, "html.parser")

        links = soup.find_all("a", href=True)

        for link in links:

            href = link["href"]

            if href.startswith("/article/"):
                href = "https://apnews.com" + href

            if href.startswith("https://apnews.com/article/"):
                article_urls.add(href)

    except Exception as e:
        print(e)

article_urls = list(article_urls)

print("URLs Found:", len(article_urls))

article_urls = article_urls[:200]

with open("ap_news.csv", "w", newline="", encoding="utf-8-sig") as file:

    writer = csv.writer(file)

    writer.writerow([
        "source_url",
        "publish_date",
        "news_paper_name",
        "title",
        "first_paragraph"
    ])

    count = 0

    for url in article_urls:

        try:

            response = requests.get(url, headers=headers, timeout=15)
            soup = BeautifulSoup(response.text, "html.parser")

            title = soup.find("h1")

            date = soup.find("span", attrs={"data-key": "timestamp"})

            paragraph = soup.select_one("div.RichTextStoryBody p")

            writer.writerow([
                url,
                date.get_text(strip=True) if date else "Not available",
                "AP News",
                title.get_text(strip=True) if title else "Not available",
                paragraph.get_text(strip=True) if paragraph else "Not available"
            ])

            count += 1
            print(count)

            time.sleep(1)

        except Exception as e:
            print("Error:", e)

print("Scraping Completed!")